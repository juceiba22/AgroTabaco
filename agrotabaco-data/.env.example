# Mismo proyecto Supabase que el portal principal (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Project Settings > API > Project API keys > service_role. SECRETO — nunca
# lo expongas con el prefijo NEXT_PUBLIC_, nunca lo commitees con un valor
# real. Sólo lo usa el webhook de Mercado Pago para activar suscripciones
# (bypassea RLS a propósito, ver supabase/migrations/0010_data_subscriptions.sql).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Mercado Pago Developers > Tus integraciones > Credenciales. SECRETO.
MERCADOPAGO_ACCESS_TOKEN=tu-access-token

# URL del portal de noticias AgroTabaco (Next.js), para el link "Volver al
# portal" en el nav. En local suele ser http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
