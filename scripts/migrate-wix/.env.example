# Proyecto de Supabase (Project Settings > API)
SUPABASE_URL=https://tu-proyecto.supabase.co

# service_role key (NO la anon key) - Project Settings > API > service_role.
# Este script corre server-side una sola vez y necesita saltarse RLS
# para poder escribir en la tabla posts y en el bucket media.
# Nunca la subas a git ni la uses en el frontend.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
