# Credenciales del proyecto de Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# API key de Anthropic (https://console.anthropic.com) para el asistente de
# redacción y la importación del boletín en el panel de admin. Server-only,
# nunca se expone al cliente. Modelo por defecto: claude-haiku-4-5 (opcional:
# ANTHROPIC_MODEL para cambiarlo).
ANTHROPIC_API_KEY=tu-anthropic-api-key

# API key de Gemini: sólo la usa el asistente del Mercado (hoy deshabilitado).
GEMINI_API_KEY=tu-gemini-api-key

# URL del dashboard estadístico "TabacoStats Argentina" (app Streamlit
# separada, ver carpeta "Mercado Argentino de Tabaco"). En local suele ser
# http://localhost:8501; actualizar cuando se despliegue en un dominio real.
NEXT_PUBLIC_STATS_URL=http://localhost:8501

# URL del dashboard "Mercado Internacional de Tabaco" (app Streamlit
# separada, ver carpeta "Mercado Global de tabaco"). En local suele ser
# http://localhost:8502; actualizar cuando se despliegue en un dominio real.
NEXT_PUBLIC_GLOBAL_MARKET_URL=http://localhost:8502
